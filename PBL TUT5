#include <iostream>
#include <cmath>
using namespace std;

double interest(double p, double r, double t)
{
    return (p * r * t) / 100;
}

double interest(double p, double r, double t, int n)
{
    return p * pow((1 + r / (100 * n)), n * t) - p;
}

int main()
{
    double principal, rate, time;
    int frequency;

    cout << "Enter Principal: ";
    cin >> principal;

    cout << "Enter Rate of Interest (%): ";
    cin >> rate;

    cout << "Enter Time (years): ";
    cin >> time;

    cout << "Enter number of times interest is compounded per year: ";
    cin >> frequency;

    cout << "\nSimple Interest = "
         << interest(principal, rate, time);

    cout << "\nCompound Interest = "
         << interest(principal, rate, time, frequency);

    return 0;
}
