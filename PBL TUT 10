#include <iostream>
#include <string>
using namespace std;

int main()
{
    string password;

    cout << "Enter password: ";
    cin >> password;

    try
    {
        if (password.length() < 8)
        {
            throw "Password length is too short!";
        }

        cout << "Password accepted successfully." << endl;
    }
    catch (const char* msg)
    {
        cout << "Exception: " << msg << endl;
    }

    return 0;
}
